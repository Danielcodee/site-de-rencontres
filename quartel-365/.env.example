# Copia este ficheiro para ".env.local" e preenche os valores reais.
# Sem estas variáveis, o formulário de contacto e a newsletter continuam a
# funcionar (validam e registam o pedido nos logs do servidor), mas não
# enviam nenhum email.

# Chave de API da Resend (https://resend.com) para envio de emails.
RESEND_API_KEY=

# Email que recebe as mensagens do formulário de contacto e da newsletter.
CONTACT_TO_EMAIL=teamcoelhomuaythai@gmail.com
